{
    "name":  "soapbox-rate-request-bot",
    "version":  "1.0.0",
    "private":  true,
    "description":  "Internal Slack app for Soapbox rate request intake and tracking.",
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/index.ts",
                    "start":  "node dist/src/index.js",
                    "build":  "tsc -p tsconfig.json",
                    "test":  "vitest run",
                    "lint":  "tsc -p tsconfig.json --noEmit",
                    "migrate":  "tsx src/db/migrate.ts"
                },
    "dependencies":  {
                         "@slack/bolt":  "^5.0.0",
                         "@slack/types":  "^3.0.0",
                         "better-sqlite3":  "^13.0.2",
                         "dotenv":  "^17.4.2",
                         "pino":  "^10.3.1",
                         "zod":  "^4.4.3",
                         "@slack/web-api":  "^8.0.0"
                     },
    "devDependencies":  {
                            "@types/better-sqlite3":  "^7.6.12",
                            "@types/node":  "^22.10.7",
                            "tsx":  "^4.19.2",
                            "typescript":  "^5.9.3",
                            "vitest":  "^2.1.9"
                        }
}